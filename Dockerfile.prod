# ═══════════════════════════════════════════════════════════════════
# Étape 1 — Build React (Node 20)
# ═══════════════════════════════════════════════════════════════════
FROM node:20-alpine AS frontend-builder

WORKDIR /frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build


# ═══════════════════════════════════════════════════════════════════
# Étape 2 — Backend Django + build React intégré
# ═══════════════════════════════════════════════════════════════════
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Copie le build React dans le dossier servi par WhiteNoise
COPY --from=frontend-builder /frontend/dist ./frontend_build

ENV DJANGO_SETTINGS_MODULE=config.settings.prod
ENV PORT=8000

# Collecte les fichiers statiques (ne nécessite pas la base de données)
RUN SECRET_KEY=temp-build-key python manage.py collectstatic --no-input

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/docker-entrypoint.sh"]
