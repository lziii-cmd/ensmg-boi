# Copier en .env.prod et remplir les valeurs avant de lancer docker-compose.prod.yml

SECRET_KEY=remplace-par-une-cle-secrete-longue-et-aleatoire
DEBUG=False

ALLOWED_HOSTS=ton-domaine.com,www.ton-domaine.com
CORS_ALLOWED_ORIGINS=https://ton-domaine.com
FRONTEND_URL=https://ton-domaine.com

# Base de données (utilisé par docker-compose.prod.yml)
POSTGRES_DB=ensmg_boi
POSTGRES_USER=ensmg_admin
POSTGRES_PASSWORD=remplace-par-un-mot-de-passe-fort

# Email (Mailgun ou autre SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_HOST_USER=ton@email.com
EMAIL_HOST_PASSWORD=ton-mot-de-passe-smtp
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ensmg.sn

# Gunicorn (optionnel)
GUNICORN_WORKERS=2
PORT=8000
